# ── Обовʼязкове ─────────────────────────────────────────────
# Пароль для входу організаторів (один на всіх).
APP_PASSWORD=change_me
# Секрет для підпису сесій: будь-який довгий випадковий рядок (мін. 16 символів).
# Згенерувати: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# ── Сервер ──────────────────────────────────────────────────
PORT=8080
# HOST=0.0.0.0
# Тека з базою та медіа (у Docker — /data, змонтована з ./data).
# DATA_DIR=./data
# Постав true, якщо сайт відкривається через HTTPS (напр. за Caddy/nginx).
# SECURE_COOKIES=false
# Скільки живе сесія без активності.
# SESSION_TTL=168h

# ── Медіа ───────────────────────────────────────────────────
# Якість кліпів для показу: 480, 720 або 1080.
# CLIP_HEIGHT=720
# Паралельних завантажень / нарізок.
# DOWNLOAD_WORKERS=2
# RENDER_WORKERS=1
# Макс. розмір файлу, який можна завантажити вручну (МБ).
# MAX_UPLOAD_MB=2048

# ── YouTube на VPS (див. README) ───────────────────────────
# Проксі для yt-dlp, напр. тунель через домашній компʼютер:
# YTDLP_PROXY=socks5://host.docker.internal:1080
# Cookies акаунта YouTube у форматі Netscape (поклади файл у ./data):
# YTDLP_COOKIES=/data/cookies.txt
# Додаткові аргументи yt-dlp (через пробіл):
# YTDLP_EXTRA_ARGS=
# Оновлювати yt-dlp при кожному старті контейнера (рекомендовано).
# YTDLP_AUTO_UPDATE=true
# Брати нічні збірки yt-dlp, коли YouTube щойно щось зламав.
# YTDLP_NIGHTLY=false
# Встановити плагін для контейнера pot-provider (docker compose --profile pot).
# YTDLP_POT_PROVIDER=false
